{
  "name": "olympiad-aggregator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "BUN_PUBLIC_BUILD_ID=$(bun scripts/buildId.ts) BUN_PUBLIC_BUILD_TIME=$(date -u +%Y-%m-%dT%H:%M:%SZ) bun --hot src/index.ts",
    "build": "bun build.ts",
    "lint": "prettier . --ignore-path .gitignore --write --log-level warn && eslint . --fix && tsc --pretty && knip --no-progress",
    "parse": "bun scripts/parse.ts",
    "normalize:schools": "bun scripts/normalizeSchools.ts",
    "normalize:cities": "bun scripts/convertCities.ts",
    "normalize:regions": "bun scripts/normalizeRegions.ts",
    "normalize": "bun scripts/normalizeSchools.ts && bun scripts/convertCities.ts && bun scripts/normalizeRegions.ts"
  },
  "dependencies": {
    "@google/genai": "^2.6.0",
    "@nalinor/mupdf4llm": "0.4.0",
    "@noble/hashes": "^2.2.0",
    "@sindresorhus/slugify": "^3.0.0",
    "@tanstack/react-table": "^8.21.3",
    "bun-plugin-tailwind": "^0.1.2",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "domhandler": "^6.0.1",
    "flexsearch": "^0.8.212",
    "iconv-lite": "^0.7.2",
    "lucide-react": "^1.8.0",
    "onnxruntime-node": "^1.23.2",
    "p-retry": "^8.0.0",
    "ppu-paddle-ocr": "^6.6.0",
    "radix-ui": "^1.4.3",
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^7.13.2",
    "recharts": "3.8.0",
    "simple-icons": "^16.15.0",
    "simple-statistics": "^7.8.9",
    "tailwind-merge": "^3.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jiti": "^2.6.1",
    "knip": "^6.27.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.57.2"
  }
}

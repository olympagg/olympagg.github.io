# Normalize line endings: LF in the repo, auto-converted on checkout.
# Keeps the Windows dev machine and the Linux CI from fighting over EOLs
# (which would otherwise make `bun lint` report spurious diffs).
* text=auto eol=lf

# Binary assets — never touch their bytes.
*.otf binary
*.pdf binary
*.xlsx binary
*.png binary
*.jpg binary
*.ico binary
